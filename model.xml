<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<featureModel>
	<properties>
		<graphics key="autolayoutconstraints" value="false"/>
		<graphics key="legendautolayout" value="true"/>
		<graphics key="showconstraints" value="true"/>
		<graphics key="showshortnames" value="false"/>
		<graphics key="layout" value="horizontal"/>
		<graphics key="showcollapsedconstraints" value="true"/>
		<graphics key="legendhidden" value="false"/>
		<graphics key="layoutalgorithm" value="1"/>
	</properties>
	<struct>
		<and abstract="true" mandatory="true" name="ElevatorSim">
			<feature mandatory="true" name="Configure"/>
			<and abstract="true" mandatory="true" name="Elevator">
				<graphics key="collapsed" value="false"/>
				<and abstract="true" mandatory="true" name="Operation">
					<or abstract="true" mandatory="true" name="Modes">
						<feature name="Sabbath"/>
						<feature name="FIFO"/>
						<feature name="ShortestPath"/>
					</or>
					<feature name="Service"/>
					<feature name="Standby"/>
					<or abstract="true" name="Priorities">
						<feature name="RushHour"/>
						<feature name="FloorPriority"/>
						<feature name="PersonPriority"/>
					</or>
				</and>
				<and abstract="true" name="Security">
					<feature mandatory="true" name="FloorPermission"/>
				</and>
				<and abstract="true" mandatory="true" name="Safety">
					<feature mandatory="true" name="Overloaded"/>
					<or abstract="true" name="Emergencies">
						<feature name="Firefighter"/>
						<feature name="Seismic"/>
						<feature name="PowerFailure"/>
					</or>
				</and>
				<and abstract="true" name="Accessibility">
					<feature mandatory="true" name="ExtendedDoorTime"/>
				</and>
				<or abstract="true" name="Devices">
					<alt name="CallButtons">
						<feature name="DirectedCall"/>
						<feature name="UndirectedCall"/>
						<feature name="Destination"/>
					</alt>
					<feature name="HallPositionIndicator"/>
					<feature name="AudibleSignal"/>
					<and name="VoiceOutput">
						<or abstract="true" mandatory="true" name="Languages">
							<feature name="Spanish"/>
							<feature name="English"/>
						</or>
					</and>
				</or>
			</and>
			<and abstract="true" name="GroupControl">
				<graphics key="collapsed" value="false"/>
				<or abstract="true" mandatory="true" name="Strategy">
					<feature name="Nearest"/>
					<feature name="LoadBased"/>
					<feature name="EstimatedTime"/>
					<feature name="Zoning"/>
				</or>
				<or abstract="true" name="Parking">
					<feature name="HomingReturn"/>
					<feature name="IntelligentCarParking"/>
				</or>
			</and>
			<alt abstract="true" mandatory="true" name="Simulation">
				<graphics key="collapsed" value="false"/>
				<feature name="Manual"/>
				<and name="Automatic">
					<alt abstract="true" mandatory="true" name="ArrivalPattern">
						<feature name="Uniform"/>
						<feature name="Poisson"/>
						<feature name="PeakTraffic"/>
					</alt>
				</and>
			</alt>
			<and abstract="true" name="Monitoring">
				<graphics key="collapsed" value="false"/>
				<alt abstract="true" mandatory="true" name="Frontend">
					<feature name="GUI"/>
					<feature name="Console"/>
				</alt>
				<feature name="Metrics"/>
				<feature name="EventLogging"/>
				<feature name="LogReplay"/>
			</and>
		</and>
	</struct>
	<constraints>
		<rule>
			<imp>
				<var>DirectedCall</var>
				<var>ShortestPath</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>CallButtons</var>
				<disj>
					<var>FIFO</var>
					<var>ShortestPath</var>
				</disj>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>Manual</var>
				<var>CallButtons</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>LogReplay</var>
				<var>EventLogging</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>LoadBased</var>
				<var>Automatic</var>
			</imp>
		</rule>
	</constraints>
</featureModel>
